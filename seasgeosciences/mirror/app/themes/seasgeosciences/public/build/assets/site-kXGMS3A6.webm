<style>
  @supports (selector(::view-transition-old(root))) {
    @keyframes fade-in {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    @keyframes fade-out {
      from {
        opacity: 1;
      }

      to {
        opacity: 0;
      }
    }

    @view-transition {
      navigation: auto;
    }

    ::view-transition-old(root) {
      opacity: 1 !important;
      animation: 0.65s cubic-bezier(0.22, 1, 0.36, 1) both fade-out;
      z-index: 1;
    }

    ::view-transition-new(root) {
      animation: 0.65s cubic-bezier(0.22, 1, 0.36, 1) both fade-in;
      z-index: 2;
    }
  }
</style>

